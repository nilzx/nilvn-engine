{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@nilvn/core": ["../core/src/index.ts"],
      "@nilvn/engine": ["../engine/src/index.ts"]
    }
  },
  "include": ["src"]
}
