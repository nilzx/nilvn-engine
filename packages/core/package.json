{
  "name": "@nilvn/core",
  "version": "0.17.0",
  "type": "module",
  "description": "NilVN shared core \u2014 the project document model (IR), command / plugin-manifest schemas, script-package format and serializers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nilzx/nilvn-engine.git",
    "directory": "packages/core"
  },
  "keywords": [
    "nilvn",
    "visual-novel",
    "adv",
    "galgame"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.lib.json",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
